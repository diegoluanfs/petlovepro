{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.[pP][dD][fF]",
      "**/*.[mM][dD]",
      "**/*.[zZ][iI][pP]",
      "**/*.csv",
      "**/*.docx",
      "**/*.epub",
      "**/*.rar",
      "**/*.7z"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      }
    ],
    "predeploy": [
      "node scripts/check-public.cjs --require-covers"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "**/*.local",
      "**/*.pdf",
      "**/*.epub",
      "**/*.zip",
      "**/*.md",
      "**/ebook.html",
      "**/cole\u00e7\u00f5es/**",
      "**/colecoes/**",
      "**/private/**",
      "**/controle-editorial/**",
      "**/bonus/**",
      "**/*.local.json"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    }
  }
}
